# ─────────────────────────────────────────────────────────────
# Maitena Joyas — variables de entorno
# Copiá este archivo a `.env.local` y completá los valores.
# NUNCA subas `.env.local` a GitHub. En Vercel se cargan en
# Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio, sin barra final. En Vercel: el dominio real (https://…).
# Mercado Pago la usa para el regreso a la tienda y el aviso de pagos: con localhost no funcionan.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: la "Publishable key" (sb_publishable_…) o la anon key clásica.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA (solo servidor, jamás con prefijo NEXT_PUBLIC): la "Secret key" (sb_secret_…)
# o la service_role clásica. Se salta todas las reglas de seguridad de la base.
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago Uruguay ─────────────────────────────────────
# SECRETAS: solo servidor. Guía paso a paso en el README (sección "Mercado Pago").
# Access Token: Tus integraciones → tu aplicación → Credenciales de prueba (después, las de producción).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook: Tus integraciones → Webhooks → (evento "Pagos") → Clave secreta.
MERCADOPAGO_WEBHOOK_SECRET=

# ── Solo desarrollo ──────────────────────────────────────────
# Permite probar el checkout aunque todavía no estén cargados los costos de envío.
# Se ignora en producción: allí no se vende hasta configurar los envíos.
# ALLOW_UNCONFIGURED_SHIPPING=true

# ── Emails (Resend) ──────────────────────────────────────────
# SECRETA: solo servidor.
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, ej: Maitena Joyas <pedidos@tudominio.com>
EMAIL_FROM=
# Dónde llegan los avisos de nueva venta
ADMIN_NOTIFICATION_EMAIL=
