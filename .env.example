# ─────────────────────────────────────────────────────────────
# Maitena Joyas — variables de entorno
# Copiá este archivo a `.env.local` y completá los valores.
# NUNCA subas `.env.local` a GitHub. En Vercel se cargan en
# Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: la "Publishable key" (sb_publishable_…) o la anon key clásica.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA (solo servidor, jamás con prefijo NEXT_PUBLIC): la "Secret key" (sb_secret_…)
# o la service_role clásica. Se salta todas las reglas de seguridad de la base.
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago Uruguay ─────────────────────────────────────
# Tus integraciones → Credenciales (usar las de prueba primero)
# SECRETAS: solo servidor.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks (para verificar la firma x-signature)
MERCADOPAGO_WEBHOOK_SECRET=

# ── Emails (Resend) ──────────────────────────────────────────
# SECRETA: solo servidor.
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, ej: Maitena Joyas <pedidos@tudominio.com>
EMAIL_FROM=
# Dónde llegan los avisos de nueva venta
ADMIN_NOTIFICATION_EMAIL=

# ── Cron (liberar reservas de stock vencidas) ────────────────
# Vercel envía este valor como `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
